# Porta do servidor
PORT=3000

# URL pública do site, SEM barra no final.
# O Instagram baixa as fotos/vídeos a partir desta URL na hora de publicar,
# então ela precisa ser acessível pela internet via HTTPS.
# Em desenvolvimento, use um túnel (ex.: `cloudflared tunnel --url http://localhost:3000` ou ngrok).
PUBLIC_BASE_URL=https://postly.seudominio.com.br

# Chave secreta usada para criptografar os tokens e assinar a sessão.
# Gere com: openssl rand -hex 32   (NÃO troque depois, ou os tokens salvos ficam ilegíveis)
APP_SECRET=

# Senha para entrar no painel
ADMIN_PASSWORD=

# App da Meta com o produto "Instagram" (API com login do Instagram).
# Em developers.facebook.com > Seu app > Instagram > Configuração da API com login do Instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Versão da Graph API (opcional)
GRAPH_API_VERSION=v24.0

# Pasta onde ficam o banco SQLite e as mídias enviadas (opcional)
DATA_DIR=./data

# Intervalo do agendador em segundos (opcional)
SCHEDULER_INTERVAL_SECONDS=15

# Tentativas em caso de erro temporário da API (opcional)
PUBLISH_MAX_ATTEMPTS=3
